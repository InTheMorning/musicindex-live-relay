[Unit]
Description=MusicIndex live metadata relay
After=network.target
# A corrupt state file fails each start. Five failed starts in 300 seconds
# stop the restart loop, and systemd marks the unit failed.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# ADR 0010: the packages install the binary in /usr/bin and make this user
# with packaging/sysusers.d/musicindex-live-relay.conf. systemd makes the
# state directory for this user.
User=musicindex-live-relay
Group=musicindex-live-relay
Environment=BIND=127.0.0.1:8018
ExecStart=/usr/bin/musicindex-live-relay
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=musicindex-live-relay
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
