[Unit]
Description=MusicIndex live metadata relay
After=network.target
# A corrupt state file fails each start. Five failed starts in 300 seconds
# stop the restart loop, and systemd marks the unit failed.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Environment=BIND=127.0.0.1:8018
ExecStart=/usr/local/bin/musicindex-live-relay
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=musicindex-live-relay
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
